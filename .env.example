# The SPA talks to the Netlify function under this prefix. Better Auth is
# served from "<REACT_APP_API_BASE_URL>/auth".
REACT_APP_API_BASE_URL=/api

# --- Netlify function (server side) ---

MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DATABASE=liftlog

# Must match the origin the app is served from, port included. Google's
# redirect URI is "<BETTER_AUTH_URL>/api/auth/callback/google".
BETTER_AUTH_URL=http://localhost:8888
# Any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The master admin. Comma-separated; these accounts alone may create, rename
# and delete logs. Everyone else who signs in can read and edit entries.
SUPERUSER_EMAIL=

# Extra browser origins allowed to call the API and sign in (comma-separated).
FRONTEND_ORIGIN=
