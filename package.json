{
  "name": "lift-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@primer/octicons-react": "^19.38.0",
    "axios": "^1.18.0",
    "better-auth": "^1.7.5",
    "bootstrap": "^5.3.8",
    "mongodb": "^7.5.0",
    "react": "^19.3.0",
    "react-animate-height": "^3.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "reactstrap": "^9.2.3",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "typesafe-actions": "^4.4.2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "npx --yes netlify-cli dev",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "MONGODB_INTEGRATION_URI=mongodb://localhost:27018/?replicaSet=rs0 vitest run netlify/functions/lift-log-api/mongoRepository.integration.test.ts",
    "typecheck": "tsc --noEmit && tsc -p netlify/functions/tsconfig.json",
    "lint": "eslint .",
    "db:start": "bash scripts/start-test-mongodb.sh",
    "db:stop": "docker compose -p lift-log-test -f docker-compose.mongodb.yml down --volumes"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@netlify/functions": "^5.3.0",
    "@redux-devtools/extension": "^4.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^3.2.6"
  }
}
